{
  "name": "convertx-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/desktop",
    "packages/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:desktop": "npm run dev -w @convertx/desktop",
    "build:desktop": "npm run build -w @convertx/desktop",
    "tauri": "npm run tauri -w @convertx/desktop --",
    "dev:web": "npm run dev -w @convertx/web",
    "build:web": "npm run build -w @convertx/web",
    "preview:web": "npm run preview -w @convertx/web"
  }
}
