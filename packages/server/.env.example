# Compose variables (paths only, no secrets). Copy to .env next to compose.yml on the NAS.
DATA_DIR=/volume1/docker/convertx/data
ENV_DIR=/volume1/docker/convertx/env

# Secrets live OUTSIDE the git checkout:
#   ${ENV_DIR}/api.env     -> see api.env.example (ORIGIN_KEY, optional tuning)
#   ${ENV_DIR}/egress.env  -> see egress.env.example (EGRESS_TOKEN; read by api AND egress)
#   ${ENV_DIR}/tunnel.env  -> see tunnel.env.example (TUNNEL_TOKEN)
