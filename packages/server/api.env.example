# convertx-api settings. Copy to /volume1/docker/convertx/env/api.env and chmod 600.
# Keep comments on their own lines (env_file values are taken literally).
# EGRESS_MODE / EGRESS_HOST / EGRESS_PROXY_PORT are set by compose.yml, and
# EGRESS_TOKEN comes from egress.env — don't set them here.

# Shared secret with the gateway Worker (`npx wrangler secret put ORIGIN_KEY`, same value).
# Generate: openssl rand -hex 32
# During a rotation it may hold two keys, "new,old" (README -> Rotating keys).
ORIGIN_KEY=

# ── Optional tuning (defaults shown) ──
# yt-dlp downloads running at once:
# MAX_CONCURRENT_JOBS=2
# Waiting jobs before POST /jobs answers 503:
# MAX_QUEUE=20
# Jobs per access key per hour (the gateway sends the key's name):
# JOBS_PER_KEY_PER_HOUR=40
# Finished files are deleted after this many minutes:
# JOB_TTL_MIN=30
# Hard stop for one download, minutes:
# JOB_TIMEOUT_MIN=30
# yt-dlp --max-filesize, the /direct cap and the finished-file cap.
# A running job is stopped once its staging dir passes twice this:
# MAX_FILESIZE=2G
# No new jobs while /data has less than this many GB free (0 = off):
# MIN_FREE_GB=20
# MAX_CONCURRENT_PROBES=4
# PROBE_TIMEOUT_SEC=90
# 0 = never update yt-dlp automatically:
# YTDLP_AUTO_UPDATE_HOURS=24
# Optional Netscape cookies.txt for login-gated sites:
# COOKIES_FILE=/data/cookies.txt
# LOG_LEVEL=info
