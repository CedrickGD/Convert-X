# Egress proxy secret. Copy to /volume1/docker/convertx/env/egress.env and chmod 600.
# BOTH the api and the egress container read this file (compose.yml), so the
# value always matches. Keep only EGRESS_* settings here.

# The api presents it to the egress proxy (Proxy-Authorization: Basic);
# anything else on the internal network gets 407. Letters, digits . _ ~ -
# only, at least 16 characters. Generate: openssl rand -hex 32
EGRESS_TOKEN=

# Ports the proxy may connect to (destinations must also be public addresses):
# EGRESS_ALLOWED_PORTS=80,443,8080,8443
